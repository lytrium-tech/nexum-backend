# ─────────────────────────────────────────────
# Nexum Backend — .env.example
# ─────────────────────────────────────────────
# Copia este archivo como .env y completa los valores reales.
# Nunca subas .env al repositorio.
# Los SecretStr en pydantic-settings evitan que los secretos aparezcan en logs.

# ── Aplicación ────────────────────────────────
APP_NAME=nexum-backend
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=true

# ── Logging ───────────────────────────────────
# Nivel de log. Si no se define, se deriva de DEBUG.
# Valores: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=

# ── Base de datos ─────────────────────────────
# Formato: postgresql+asyncpg://user:password@host:port/database
# Vacío permitido en development y test.
# OBLIGATORIO en production.
DATABASE_URL=

# ── Supabase ──────────────────────────────────
# OBLIGATORIO en production.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Gemini ────────────────────────────────────
# OBLIGATORIO en production.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── Auth bypass ───────────────────────────────
# Permitido SOLO en development y test.
# En production debe ser false o el startup fallará.
AUTH_BYPASS_ENABLED=true
DEV_USER_ID=00000000-0000-0000-0000-000000000001
DEV_USER_EMAIL=dev@nexum.local
