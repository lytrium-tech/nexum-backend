# ─────────────────────────────────────────────
# Nexum Backend — .gitignore
# ─────────────────────────────────────────────

# Agent configuration — never track local MCP credentials
.agents/
docs/agent/

# Entorno virtual y uv
.venv/
.uv/
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/

# Variables de entorno (nunca subir secretos)
.env
.env.local
.env.*.local

# Pytest y coverage
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# Ruff / linters
.ruff_cache/

# Editors
.idea/
.vscode/
*.swp
*.swo

# Logs locales
logs/
*.log

# Alembic — el directorio migrations sí se versiona
# pero los archivos .pyc dentro no
migrations/__pycache__/

# macOS
.DS_Store

# Windows
Thumbs.db
scratch_*.py
recover*.py