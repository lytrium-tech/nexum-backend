# ─────────────────────────────────────────────
# Nexum Backend — .gitignore
# ─────────────────────────────────────────────

# --- Local agent configuration ---
AGENTS.md
.agents/
docs/codex/

# --- Agent outputs ---
docs/agent/*
!docs/agent/audits/
!docs/agent/audits/**
!docs/agent/cleanup/
!docs/agent/cleanup/**
!docs/agent/reports/
!docs/agent/reports/**
!docs/agent/sprint-reports/
!docs/agent/sprint-reports/**

# --- Python, uv & virtual environments ---
.venv/
.uv/
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/

# --- Environment variables / secrets ---
.env
.env.local
.env.*.local

# --- Testing / coverage / lint caches ---
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml

# --- Database / migrations cache ---
migrations/__pycache__/

# --- Temporary root scripts / recovery ---
append_test.py
fix.py
fix_*.py
recover*.py
scratch_*.py

# --- Local artifacts / logs ---
artifacts/
logs/
*.log

# --- IDEs / editors ---
.idea/
.vscode/
*.swp
*.swo

# --- OS files ---
.DS_Store
Thumbs.db

# --- Database backups ---
*.dump
backup_*.dump
